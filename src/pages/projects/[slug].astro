---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Callout from '../../components/mdx/Callout.astro';
import Finding from '../../components/mdx/Finding.astro';
import StatsGrid from '../../components/mdx/StatsGrid.astro';
import TwoCol from '../../components/mdx/TwoCol.astro';
import FigmaLink from '../../components/mdx/FigmaLink.astro';
import ProjectImage from '../../components/mdx/ProjectImage.astro';
import ImageCarousel from '../../components/mdx/ImageCarousel.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/globals.css';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      // Wrap around so the last case study still offers somewhere to go.
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, next } = Astro.props;
const { Content, headings } = await render(project);
const { title, description, category, heroImage, meta } = project.data;
const hasNext = next.id !== project.id;
---

<Base
  title={`${title} - Case Study | Siripat`}
  description={description}
  ogImage={heroImage}
>
  <Navbar client:load />
  <main class="min-h-screen bg-bg pt-20">
    <!-- Hero Section -->
    <section class="pt-8 pb-12 px-6">
      <div class="max-w-3xl mx-auto">
        <p class="text-[0.7rem] uppercase tracking-[0.2em] text-accent mb-3">
          {category}
        </p>
        <h1 class="text-3xl md:text-4xl font-bold font-heading text-fg mb-4">
          {title}
        </h1>
        <p class="text-muted text-[0.95rem] leading-relaxed mb-8 max-w-2xl">
          {description}
        </p>

        <!-- Metadata Row -->
        <div class="flex flex-wrap gap-x-6 gap-y-2 py-4 border-y border-border text-sm">
          {Object.entries(meta).map(([key, value]) => (
            <span class="text-muted">
              <span class="font-semibold text-fg">{key}</span> &middot; {value}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Hero Image -->
    <section class="px-6 pb-12">
      <div class="max-w-3xl mx-auto">
        <div class="relative aspect-[16/9] rounded-2xl overflow-hidden bg-surface">
          <img
            src={heroImage}
            alt={`${title} Mockup`}
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
      </div>
    </section>

    <TableOfContents headings={headings} />

    <!-- MDX Content -->
    <article class="mdx-content px-6 pb-16 overflow-x-hidden">
      <Content components={{ Callout, Finding, StatsGrid, TwoCol, FigmaLink, ProjectImage, ImageCarousel }} />
    </article>

    <!-- Where to go next -->
    <section class="px-6 pb-20">
      <div class="max-w-3xl mx-auto pt-8 border-t border-border">
        <div class="flex flex-wrap items-center justify-between gap-6">
          <a
            href="/projects"
            class="inline-flex items-center gap-2 text-sm text-muted hover:text-fg transition-colors duration-200"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
            </svg>
            All projects
          </a>

          {hasNext && (
            <a
              href={`/projects/${next.id}`}
              class="group inline-flex items-baseline gap-2 text-right"
            >
              <span class="text-[0.7rem] tracking-[0.15em] uppercase text-muted">Next</span>
              <span class="text-sm font-medium text-fg group-hover:text-accent transition-colors duration-200">
                {next.data.title} &rarr;
              </span>
            </a>
          )}
        </div>

        <!-- The end of a case study is the highest-intent moment on the site -->
        <div class="mt-12 p-8 border border-border rounded-lg">
          <h2 class="font-heading text-xl text-fg mb-2">
            Interested in working together?
          </h2>
          <p class="text-muted text-[0.9rem] leading-[1.7] mb-6 max-w-md">
            I'm open to UX/UI design roles. Happy to walk through my process
            behind this project.
          </p>
          <a
            href="/#contact"
            class="inline-block bg-fg text-bg px-6 py-3 rounded-full text-[0.85rem] tracking-wide transition-opacity duration-200 hover:opacity-80"
          >
            Get in touch
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
