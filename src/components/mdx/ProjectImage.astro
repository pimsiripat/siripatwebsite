---
interface Props {
  src: string;
  alt: string;
  cover?: boolean;
  background?: 'surface' | 'white';
}
const { src, alt, cover = false, background = 'surface' } = Astro.props;
---

<div class="max-w-3xl mx-auto my-10">
  <div
    class:list={[
      "relative aspect-[16/9] rounded-2xl overflow-hidden",
      background === 'white' ? 'bg-white' : 'bg-surface',
    ]}
  >
    <img
      src={src}
      alt={alt}
      class:list={["absolute inset-0 w-full h-full", cover ? "object-cover" : "object-contain"]}
      loading="lazy"
    />
  </div>
</div>
