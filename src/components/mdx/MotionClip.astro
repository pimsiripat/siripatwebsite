---
interface Props {
  src: string;
  label: string;
  // wide: breaks out past the text column; tall: a narrow frame for full-page scrolls
  size?: 'wide' | 'tall';
  // width / height of the source video, so the frame holds its shape before load
  aspect?: string;
  poster?: string;
}
const { src, label, size = 'wide', aspect = '1440 / 1024', poster } = Astro.props;
---

<div
  class:list={[
    "motion-clip mx-auto my-6 md:my-8",
    size === 'tall' ? "max-w-md" : "max-w-5xl",
  ]}
>
  <div class="relative rounded-2xl overflow-hidden bg-surface" style={`aspect-ratio: ${aspect}`}>
    <video
      data-motion-video
      src={src}
      poster={poster}
      aria-label={label}
      class="absolute inset-0 w-full h-full object-cover"
      muted
      loop
      playsinline
      preload="metadata"
    ></video>
  </div>
</div>

<script>
  import '../../scripts/motion-video';
</script>
