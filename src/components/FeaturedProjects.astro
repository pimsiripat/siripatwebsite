---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const HOME_LIMIT = 3;

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const projects = allProjects.slice(0, HOME_LIMIT);
// Only advertise the index page once it actually holds more than the home page
// shows — otherwise the link promises more and delivers the same list.
const hasMore = allProjects.length > HOME_LIMIT;
---

<section id="projects" class="py-[100px] px-6 lg:px-10">
  <div class="max-w-[1200px] mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-4 mb-14">
      <div>
        <p class="text-[0.75rem] tracking-[0.2em] uppercase text-accent mb-3">
          Projects
        </p>
        <h2 class="font-heading text-[clamp(2rem,4vw,3rem)] text-fg">
          Selected Case Studies
        </h2>
      </div>
      {hasMore && (
        <a
          href="/projects"
          class="self-start text-[0.8rem] text-muted tracking-wide hover:text-fg transition-colors duration-200 border-b border-border hover:border-fg pb-0.5"
        >
          View all projects <span aria-hidden="true">&rarr;</span>
        </a>
      )}
    </div>

    <div>
      {projects.map((project, i) => (
        <ProjectCard
          project={project}
          index={i}
          isLast={i === projects.length - 1}
        />
      ))}
    </div>
  </div>
</section>
